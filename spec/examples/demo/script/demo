#!/usr/bin/env python3
"""Print a nudge for Avery and a nudge for Blake.

The sentence is the body of the nudge nudges selects. Copy lives in
spec/examples/nudges/messages.
"""

import json
import os
import sys
from pathlib import Path


def repo_root():
    for candidate in Path(__file__).resolve().parents:
        if (candidate / "spec" / "fixtures" / "cases.json").is_file():
            return candidate
    raise SystemExit("Could not find the personas repo.")


REPO = repo_root()
sys.path.insert(0, str(REPO / "spec" / "examples" / "demo"))
sys.path.insert(0, str(REPO / "spec" / "examples" / "nudges"))
sys.path.insert(0, str(REPO / "packages" / "python"))

from audiences import bind
from messages import load_messages
from nudges_root import nudges_root
from plgkit_personas import connect, load_mapping, load_policy, migrate, persona, track

SHOW = ("avery_blocked", "blake_champion")


def main():
    backend = _backend(sys.argv[1:])
    if backend == "go":
        _exec_backend(backend)
    os.environ["PLGKIT_NUDGES_ROOT"] = str(nudges_root())
    if backend == "node":
        _exec_backend(backend)
    _python()


def _python():
    sys.path.insert(0, str(Path(os.environ["PLGKIT_NUDGES_ROOT"]) / "packages" / "python"))
    from plgkit import connect as nudge_connect
    from plgkit import decide
    from plgkit import migrate as nudge_migrate

    fixture = json.loads((REPO / "spec" / "fixtures" / "cases.json").read_text(encoding="utf-8"))
    examples = REPO / "spec" / "examples"
    mapping = load_mapping(examples / "mapping.yml")
    policy = load_policy(examples / "config.yml")
    now = fixture["calculated_at"]
    by_name = {case["name"]: case for case in fixture["cases"]}
    messages = load_messages(examples / "nudges" / "messages")
    db = connect("sqlite:///:memory:")
    migrate(db)
    nudge_db = nudge_connect("sqlite:///:memory:")
    nudge_migrate(nudge_db)
    audiences = bind(db=db, now=now, mapping=mapping, policy=policy)
    for name in SHOW:
        case = by_name[name]
        for event in case["events"]:
            stored = track(
                case["user_id"],
                event["action"],
                {"occurred_at": event["occurred_at"]},
                db=db,
                now=now,
            )
            if not stored:
                raise SystemExit(f"Could not store {event['action']} for {case['user_id']}.")
        result = persona(case["user_id"], db=db, now=now, mapping=mapping, config=policy)
        if result["persona"] != case["persona"]:
            raise SystemExit(
                f"{case['user_id']} is {result['persona']}, expected {case['persona']}."
            )
        shown = decide(
            "home",
            {"user": {"id": case["user_id"]}},
            messages,
            db=nudge_db,
            audiences=audiences,
        )
        if len(shown) != 1:
            raise SystemExit(f"{case['user_id']} matched {len(shown)} nudges.")
        line = shown[0]["render_props"]["body"]
        print(f"{case['user_id'].capitalize():<8} {result['persona']:<12} {line}")


def _backend(args):
    if not args:
        return "python"
    if len(args) == 2 and args[0] == "--backend" and args[1] in ("python", "node", "go"):
        return args[1]
    raise SystemExit("Usage: demo [--backend python|node|go]")


def _exec_backend(backend):
    os.chdir(REPO)
    if backend == "node":
        script = REPO / "packages" / "node" / "src" / "demo.ts"
        os.execvp(
            "node",
            [
                "node",
                "--disable-warning=ExperimentalWarning",
                "--experimental-strip-types",
                str(script),
            ],
        )
    os.execvp("go", ["go", "run", "./packages/go/cmd/demo"])


if __name__ == "__main__":
    main()
